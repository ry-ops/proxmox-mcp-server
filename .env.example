# Proxmox MCP Server Environment Configuration

# Proxmox host/IP, no scheme or port (required)
PROXMOX_HOST=10.88.140.151

# API port (optional, default: 8006)
PROXMOX_PORT=8006

# Proxmox user (required for both auth methods below)
PROXMOX_USER=root@pam

# API Token authentication (recommended)
PROXMOX_TOKEN_NAME=cortex-automation
PROXMOX_TOKEN_VALUE=your-token-secret-here

# Alternative: password authentication (leave the token vars above unset)
# PROXMOX_PASSWORD=your-password-here

# SSL verification (set to false for self-signed certs)
PROXMOX_VERIFY_SSL=false

# Read-only mode: refuse every write (create/update/delete and power actions);
# only GET requests reach the Proxmox API (default: false)
PROXMOX_READ_ONLY=false

# Toolsets: comma-separated API areas to load (default: all). Fewer tools cost the
# client less context. Areas: nodes, qemu, lxc, storage, cluster, access, firewall,
# disks, ceph, acme, sdn, notifications, pools, appliances
# PROXMOX_TOOLSETS=nodes,qemu,lxc,storage

# Hide the tools that delete, stop, wipe or roll back; safe writes stay (default: false)
# PROXMOX_NO_DESTRUCTIVE=true

# Guests no tool may change: IDs and ranges, e.g. your router or DNS VM
# PROXMOX_PROTECTED_VMIDS=100,101,9000-9010

# Seconds a `wait: true` call or wait_for_task lasts before returning "running" (default: 900)
# PROXMOX_WAIT_TIMEOUT=900

# HTTP entrypoint only (proxmox-mcp-server-http)
# MCP_HTTP_HOST=127.0.0.1          # bind address; anything but loopback needs a token
# MCP_HTTP_PORT=8811
# MCP_AUTH_TOKEN=                  # clients send: Authorization: Bearer <token>
# MCP_HTTP_ALLOW_NO_AUTH=false     # true only if a proxy in front authenticates clients

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Request timeout in seconds
# PROXMOX_TIMEOUT=30
