# Proxmox MCP Server Environment Configuration

# Proxmox host/IP, no scheme or port (required)
PROXMOX_HOST=10.88.140.151

# API port (optional, default: 8006)
PROXMOX_PORT=8006

# Proxmox user (required for both auth methods below)
PROXMOX_USER=root@pam

# API Token authentication (recommended)
PROXMOX_TOKEN_NAME=cortex-automation
PROXMOX_TOKEN_VALUE=your-token-secret-here

# Alternative: password authentication (leave the token vars above unset)
# PROXMOX_PASSWORD=your-password-here

# SSL verification (set to false for self-signed certs)
PROXMOX_VERIFY_SSL=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Request timeout in seconds
# PROXMOX_TIMEOUT=30
