# --- Proxmox connection ---
PROXMOX_HOST=192.168.10.21
PROXMOX_PORT=8006
PROXMOX_USER=readonly@pve
# Token auth (recommended) — create with role PVEAuditor for read-only:
PROXMOX_TOKEN_NAME=mcp
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or password auth instead of a token:
# PROXMOX_PASSWORD=
PROXMOX_VERIFY_SSL=false

# --- Safety ---
# Block every write (POST/PUT/DELETE); only GET is allowed.
PROXMOX_READ_ONLY=true

# --- Transport ---
# stdio (local) or http (remote, for v-assist)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
# If set, clients must send: Authorization: Bearer <token>. Leave empty for
# network-only (vita-style). Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
